# Normaliza finais de linha (evita diffs "fantasma" entre Windows, Linux e macOS)
* text=auto eol=lf

# Scripts do Windows precisam de CRLF
*.bat text eol=crlf
*.cmd text eol=crlf

# Arquivos binários (nunca converter)
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.ico  binary
*.pdf  binary
*.zip  binary
*.jar  binary
*.asta binary
*.astah binary
