# Copie este arquivo para "db.properties" (na mesma pasta) e preencha suas credenciais.
# O db.properties é ignorado pelo git: NUNCA versione sua senha.
# Cada chave também pode ser definida por variável de ambiente (entre parênteses).

# URL JDBC do Oracle (MD_DB_URL). Padrão: banco da FIAP
db.url=jdbc:oracle:thin:@oracle.fiap.com.br:1521:ORCL

# Usuário e senha do Oracle (MD_DB_USUARIO / MD_DB_SENHA). Obrigatórios
db.usuario=seu_usuario
db.senha=sua_senha

# Endereço da API (MD_SERVER_URI)
server.uri=http://localhost:8080/api/

# Origens do front-end liberadas no CORS, separadas por vírgula (MD_CORS_ORIGENS).
# Para avaliar o front-end abrindo frontend/dist/index.html direto do disco (file://), acrescente "null":
#   cors.origens=http://localhost:5173,null
cors.origens=http://localhost:5173

# "Cidade viva": conteúdo de demonstração para cidades novas e atividade simulada (MD_SIMULACAO_ATIVA)
simulacao.ativa=true

# Chave das rotas /api/simulacao/* (cabeçalho X-Chave-Simulacao). Sem chave, as rotas ficam desligadas
# (MD_SIMULACAO_CHAVE). Use um valor difícil de adivinhar e não o versione.
simulacao.chave=troque-esta-chave

# Chave para criar, editar e excluir temas do catálogo de direitos (cabeçalho X-Chave-Admin; MD_ADMIN_CHAVE).
# Sem chave, o catálogo fica somente leitura. Use um valor difícil de adivinhar e não o versione.
admin.chave=troque-esta-chave-admin

# Segredo que assina os tokens de sessão devolvidos no login e no cadastro (MD_TOKEN_SEGREDO).
# Use um valor longo e aleatório (pelo menos 32 caracteres) e não o versione. Para gerar um, por exemplo:
#   PowerShell: $b = New-Object byte[] 48; [Security.Cryptography.RandomNumberGenerator]::Create().GetBytes($b); [Convert]::ToBase64String($b)
#   Linux/macOS/Git Bash: openssl rand -base64 48
# Sem segredo (ou com menos de 32 caracteres), a API gera um aleatório ao subir e avisa no console:
# funciona, mas todo mundo precisa entrar de novo a cada reinício da API.
# Fica vazio de propósito: um valor de exemplo copiado sem trocar seria conhecido por qualquer pessoa.
token.segredo=
